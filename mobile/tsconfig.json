{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["../src/lib/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "../src/lib/i18n.ts", "../src/lib/pricing.ts", "../src/lib/constants.ts", "expo-env.d.ts"],
  "exclude": ["node_modules"]
}
