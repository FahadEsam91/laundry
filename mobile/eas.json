{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "22.12.0",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://68-183-76-10.sslip.io"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "customer",
        "EXPO_PUBLIC_API_URL": "http://192.168.1.10:3000"
      },
      "channel": "development"
    },
    "development-rider": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "rider",
        "EXPO_PUBLIC_API_URL": "http://192.168.1.10:3000"
      },
      "channel": "development-rider"
    },
    "customer-preview": {
      "extends": "base",
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "customer"
      },
      "android": {
        "buildType": "apk"
      },
      "channel": "preview"
    },
    "rider-preview": {
      "extends": "base",
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "rider"
      },
      "android": {
        "buildType": "apk"
      },
      "channel": "rider-preview"
    },
    "customer-production": {
      "extends": "base",
      "env": {
        "APP_VARIANT": "customer"
      },
      "autoIncrement": true,
      "channel": "production"
    },
    "rider-production": {
      "extends": "base",
      "env": {
        "APP_VARIANT": "rider"
      },
      "autoIncrement": true,
      "channel": "rider-production"
    }
  },
  "submit": {
    "customer-production": {
      "android": {
        "serviceAccountKeyPath": "./google-play-key.json",
        "track": "internal"
      }
    },
    "rider-production": {
      "android": {
        "serviceAccountKeyPath": "./google-play-key.json",
        "track": "internal"
      }
    }
  }
}
